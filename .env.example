# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Address the HTTP server binds to. Docker sets HOST=0.0.0.0.
HOST=127.0.0.1
PORT=8000

# Postgres. The defaults match compose.yaml (docker compose up -d db).
DATABASE_URL=postgresql+psycopg://pitwall:pitwall@localhost:5432/pitwall
# Only for the migration tests: an EMPTY throwaway database, wiped by every test run.
# TEST_DATABASE_URL=postgresql+psycopg://pitwall:pitwall@localhost:5432/pitwall_test
